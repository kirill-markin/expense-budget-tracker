  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "aws-cdk": "^2.1125.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
