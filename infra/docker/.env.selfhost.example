# =============================================================================
# Self-hosting stack configuration
# =============================================================================
#
# Copy to infra/docker/.env.selfhost and pass it explicitly:
#
#   docker compose -f infra/docker/compose.selfhost.yml \
#     --env-file infra/docker/.env.selfhost up -d --build
#
# The file is named .env.selfhost rather than .env on purpose: Compose reads
# infra/docker/.env automatically, and that file belongs to the development
# stack. Pass --env-file on every command, including `down`, `logs` and `exec`.
#
# Every variable here is required unless marked optional. The compose file
# spells each one as ${VAR:?...}, so a missing value stops the command instead
# of starting a service with an empty setting.
#
# Read docs/self-hosting.md first. This file configures the containers; the
# edge proxy in front of them, the paths that must bypass it, and the
# revocation procedure are documented there, and the stack must not be exposed
# without them.

# --- Hostnames ---
#
# Four public hostnames, all served over https by the edge proxy. Three of the
# four are constrained by the code, not by convention:
#
#   AUTH_HOST must be auth.<domain>      (checked at auth service startup)
#   MCP_HOST  must be mcp.<same-domain>  (checked at auth service startup, and
#                                         by a CHECK constraint on every stored
#                                         OAuth connection)
#   API_HOST  must be api.<same-domain>  (the machine API derives the MCP URL
#                                         it advertises by rewriting auth. to
#                                         mcp., and the app derives api. from
#                                         AUTH_HOST)
#
# APP_HOST is free-form; app.<same-domain> is the convention.
# A single-host path layout is not supported.
#
# The compose file derives every URL-shaped setting from these four, so they
# cannot drift apart: OAUTH_ISSUER=https://$AUTH_HOST and
# OAUTH_RESOURCE=https://$MCP_HOST/mcp on the auth and mcp services,
# PUBLIC_API_BASE_URL=https://$API_HOST/v1 and
# PUBLIC_AUTH_BASE_URL=https://$AUTH_HOST on the api service, and
# CORS_ORIGIN=https://$APP_HOST with AUTH_DOMAIN=$AUTH_HOST on the web service.

APP_HOST=app.example.com
AUTH_HOST=auth.example.com
API_HOST=api.example.com
MCP_HOST=mcp.example.com

# Required at auth service startup, inert in this mode: it scopes the Cognito
# session cookies, which are never set here. Use the shared base domain.
COOKIE_DOMAIN=example.com

# --- Edge identity ---
#
# The upstream proxy authenticates the person and forwards a signed RS256 JWT
# in a header. The token must carry `sub`, `email` and a numeric `exp`; the
# 60-second clock-skew grace is the only tolerance.
#
# The values below are the Cloudflare Access shape. Any gateway that mints an
# equivalent RS256 token works: this is configuration, not code.

AUTH_PROXY_JWT_HEADER=cf-access-jwt-assertion
AUTH_PROXY_JWKS_URL=https://<your-team>.cloudflareaccess.com/cdn-cgi/access/certs
AUTH_PROXY_JWT_ISSUER=https://<your-team>.cloudflareaccess.com

# The audience is verified exactly, and it identifies the Access application
# rather than the deployment. Put APP_HOST and AUTH_HOST in one Access
# application and both values below are the same tag; use two applications and
# each service needs its own.
AUTH_PROXY_JWT_AUDIENCE_APP=
AUTH_PROXY_JWT_AUDIENCE_AUTH=

# --- Database ---
#
# Four roles inside one Postgres container: the `tracker` superuser owns the
# schema and runs the migrations, and the app, auth_service and worker roles
# are created by the migration step with the passwords set here.
#
# These values are interpolated verbatim into connection URLs, so use only
# unreserved URL characters: letters, digits, and - . _ ~

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=

# --- Published ports ---
#
# Optional, default 127.0.0.1. The address the container ports bind to, for
# the edge proxy to reach: web 3000, auth 8081, mcp 8082, api 8083. Postgres
# is never published. Change this only if the proxy runs on another host, and
# then restrict access with a firewall — these ports carry no authentication
# of their own except the ApiKey and OAuth surfaces.
#
# SELFHOST_BIND_ADDRESS=127.0.0.1

# --- Optional integrations ---
#
# Required only for the AI chat at /chat.
# OPENAI_API_KEY=

# Langfuse tracing: set the first three together or leave all of them unset.
# LANGFUSE_RELEASE must then be a 64-character lowercase hex fingerprint.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_RELEASE=
