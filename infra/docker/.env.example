# =============================================================================
# Docker Compose overrides (optional)
# =============================================================================
#
# `make up` works on a fresh clone with no .env at all: every variable below
# already has the same default in infra/docker/compose.yml. Copy this file to
# infra/docker/.env only to change something.
#
# Precedence, highest first:
#   1. the shell environment (`CORS_ORIGIN=http://127.0.0.1:3000 make up`)
#   2. this file, once copied to infra/docker/.env
#   3. the built-in defaults in infra/docker/compose.yml
# The make targets add no environment of their own, so `make up` and
# `docker compose -f infra/docker/compose.yml up -d` resolve identically.
# Leaving AUTH_MODE= or ALLOW_INSECURE_NO_AUTH= empty here is not the same as
# deleting the line: the empty value reaches the app, which then refuses to
# start rather than falling back to the unauthenticated defaults.
#
# Compose reads .env from the compose file's own directory, so the
# repository-root .env.example does not apply here — and its URLs point at
# localhost, which inside a container means the container itself. Hostnames
# here are Compose service names (`postgres`), not localhost.

# --- Database ---

# Owner role (DDL, migrations only). Used by scripts/migrate.sh.
MIGRATION_DATABASE_URL=postgresql://tracker:tracker@postgres:5432/tracker

# App role (DML, RLS enforced). Used by the web service.
DATABASE_URL=postgresql://app:app@postgres:5432/tracker

# Role passwords created by the migration step.
APP_DB_PASSWORD=app
AUTH_DB_PASSWORD=auth_service
WORKER_DB_PASSWORD=worker

# --- Auth ---

# The only mode this stack supports. AUTH_MODE=cognito is not supported here:
# it makes the web app require the DB_HOST/DB_PASSWORD pair, while the web
# service wires DATABASE_URL, and this file cannot supply the missing pair
# because Compose reads it for variable interpolation only. The authenticated
# deployment lives in AWS (infra/aws).
AUTH_MODE=none

# Required with AUTH_MODE=none in a container: the web image runs a production
# build and binds 0.0.0.0, and the stack is published on loopback only.
# Every request is unauthenticated. Never set this on a shared host.
ALLOW_INSECURE_NO_AUTH=true

# CORS origin for CSRF checks. Must match the origin opened in the browser.
CORS_ORIGIN=http://localhost:3000

# --- Standalone auth service (the "cognito" profile) ---
#
# These configure the auth service only, which the "cognito" profile keeps out
# of the default stack. Starting it needs real Cognito credentials and does
# not give the web app an authenticated stack (see AUTH_MODE above), so it is
# useful only for working on the auth service itself. Enable the profile here
# or in the shell.
#
# COMPOSE_PROFILES=cognito
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=
# SESSION_ENCRYPTION_KEY=
# AUTH_DOMAIN=localhost:8081
# COOKIE_DOMAIN=localhost
# ALLOWED_REDIRECT_URIS=http://localhost:3000
# OAUTH_ISSUER=http://localhost:8081
# OAUTH_RESOURCE=http://localhost:8082/mcp
# AUTH_DATABASE_URL=postgresql://auth_service:auth_service@postgres:5432/tracker

# --- Optional integrations ---

# Required only for the AI chat at /chat.
# OPENAI_API_KEY=

# Langfuse tracing: set all three or none.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_RELEASE=
