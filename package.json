{
  "name": "expense-budget-tracker",
  "private": true,
  "packageManager": "npm@12.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "mammoth": {
      "@xmldom/xmldom": "0.9.10"
    },
    "postcss": "8.5.16",
    "@aws-crypto/branch-keystore-node": {
      "uuid": "11.1.1"
    },
    "@aws-crypto/material-management": {
      "uuid": "11.1.1"
    },
    "@aws-crypto/serialize": {
      "uuid": "11.1.1"
    }
  }
}
