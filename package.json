{
  "name": "expense-budget-tracker",
  "private": true,
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "devDependencies": {
    "ajv-cli": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs": false,
    "@mongodb-js/zstd": false,
    "node-liblzma": false
  },
  "overrides": {
    "fast-json-patch": "3.1.1",
    "mammoth": {
      "@xmldom/xmldom": "0.9.12"
    },
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "@aws-crypto/branch-keystore-node": {
      "uuid": "11.1.1"
    },
    "@aws-crypto/material-management": {
      "uuid": "11.1.1"
    },
    "@aws-crypto/serialize": {
      "uuid": "11.1.1"
    }
  }
}
