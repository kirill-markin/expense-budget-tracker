{
  "description": "Rate limit MCP requests per client IP",
  "expression": "(http.request.uri.path eq \"/mcp\")",
  "action": "block",
  "enabled": true,
  "ratelimit": {
    "characteristics": [
      "cf.colo.id",
      "ip.src"
    ],
    "period": 10,
    "requests_per_period": 20,
    "mitigation_timeout": 10
  }
}
