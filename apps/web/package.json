{
  "name": "expense-budget-tracker-web",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../.. run build --workspace @expense-budget-tracker/agent-shared && node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "npm --prefix ../.. run build --workspace @expense-budget-tracker/agent-shared && node scripts/copy-pdfjs-assets.mjs",
    "prelint": "npm --prefix ../.. run build --workspace @expense-budget-tracker/agent-shared",
    "pretest": "npm --prefix ../.. run build --workspace @expense-budget-tracker/agent-shared",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H ${HOST:-127.0.0.1}",
    "lint": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "npx playwright test",
    "test:e2e:local-demo": "npx playwright test --config=playwright.local-demo.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@expense-budget-tracker/agent-shared": "1.7.0",
    "@langfuse/openai": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "aws-jwt-verify": "^5.2.1",
    "d3": "^7.9.0",
    "heic-to": "^1.6.6",
    "i18next": "^26.4.4",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
