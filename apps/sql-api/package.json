    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "js-tiktoken": "^1.0.21",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
